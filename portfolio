                setTimeout(() => {
                    loader.style.display = 'none';
                }, 500);
            }, 1000);

            // تنظیمات اولیه زبان
            let currentLang = localStorage.getItem('language') || 'fa';
            
            // تغییر زبان
            function changeLanguage(lang) {
                currentLang = lang;
                localStorage.setItem('language', lang);
                
                // تغییر متن‌ها
                document.querySelectorAll('[data-i18n]').forEach(element => {
                    const key = element.getAttribute('data-i18n');
                    if (translations[lang][key]) {
                        element.textContent = translations[lang][key];
                    }
                });
                
                // تغییر placeholderها
                document.querySelectorAll('[data-i18n-placeholder]').forEach(element => {
                    const key = element.getAttribute('data-i18n-placeholder');
                    if (translations[lang][key]) {
                        element.placeholder = translations[lang][key];
                    }
                });
                
                // تغییر جهت صفحه
                if (lang === 'fa') {
                    document.documentElement.dir = 'rtl';
                    document.documentElement.lang = 'fa';
                    document.getElementById('languageIcon').textContent = 'EN';
                    if (document.getElementById('languageIconMobile')) {
                        document.getElementById('languageIconMobile').textContent = 'EN';
                    }
                } else {
                    document.documentElement.dir = 'ltr';
                    document.documentElement.lang = 'en';
                    document.getElementById('languageIcon').textContent = 'فا';
                    if (document.getElementById('languageIconMobile')) {
                        document.getElementById('languageIconMobile').textContent = 'فا';
                    }
                }
                
                // تغییر عنوان صفحه
                document.title = lang === 'fa' ? 'جاهد بیات | توسعه‌دهنده فول استک' : 'jahid Bayat | Full Stack Developer';
            }

            // دکمه تغییر زبان
            const languageToggle = document.getElementById('languageToggle');
            const languageToggleMobile = document.getElementById('languageToggleMobile');
            
            function toggleLanguage() {
                const newLang = currentLang === 'fa' ? 'en' : 'fa';
                changeLanguage(newLang);
            }

            languageToggle.addEventListener('click', toggleLanguage);
            if (languageToggleMobile) {
                languageToggleMobile.addEventListener('click', toggleLanguage);
            }

            // بارگذاری زبان ذخیره شده
            changeLanguage(currentLang);

            // تغییر تم
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            const themeToggleMobile = document.getElementById('themeToggleMobile');
            const themeIconMobile = document.getElementById('themeIconMobile');

            function toggleTheme() {
                document.body.classList.toggle('dark-mode');
                const isDark = document.body.classList.contains('dark-mode');
                
                if (isDark) {
                    themeIcon.textContent = '☀️';
                    if (themeIconMobile) themeIconMobile.textContent = '☀️';
                    localStorage.setItem('theme', 'dark');
                } else {
                    themeIcon.textContent = '🌙';
                    if (themeIconMobile) themeIconMobile.textContent = '🌙';
                    localStorage.setItem('theme', 'light');
                }
            }

            // بررسی تم ذخیره شده
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.body.classList.add('dark-mode');
                themeIcon.textContent = '☀️';
                if (themeIconMobile) themeIconMobile.textContent = '☀️';
            }

            themeToggle.addEventListener('click', toggleTheme);
            if (themeToggleMobile) {
                themeToggleMobile.addEventListener('click', toggleTheme);
            }

            // منوی موبایل
            const hamburger = document.getElementById('hamburger');
            const mobileMenu = document.getElementById('mobileMenu');
            const mobileLinks = mobileMenu.querySelectorAll('.nav-link');

            hamburger.addEventListener('click', function() {
                mobileMenu.classList.toggle('active');
                hamburger.classList.toggle('active');
            });

            mobileLinks.forEach(link => {
                link.addEventListener('click', function() {
                    mobileMenu.classList.remove('active');
                    hamburger.classList.remove('active');
                });
            });

            // اسکرول نرم
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return;
                    
                    const target = document.querySelector(targetId);
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // فرم تماس
