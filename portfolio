                        <div class="profile-image-wrapper">
                            <img src="../img/1999_12_31_11_36_IMG_0239.JPG" alt="jahidBayat" class="profile-image" id="profileImage">
                            <div class="image-glow"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <h2 class="section-title" data-i18n="about.title">About Me</h2>
            <div class="about-content">
                <div class="about-text">
                    <p data-i18n="about.p1">
                        I am jahid Bayat, a Full Stack Developer with 2 years of professional experience at Tawana Technology. Currently, I am pursuing my Bachelor's degree in Computer Science at Ghurjestan Private University.
